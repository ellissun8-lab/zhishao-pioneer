data/cv_synthetic/images/
data/cv_synthetic/labels/
data/cv_synthetic_ood/images/
data/cv_synthetic_ood/labels/
# 本地训练运行目录（正式产物 models/cv_detector/best.pt + metrics.json 随仓库发布）
runs/
